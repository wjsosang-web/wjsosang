# ---------------------------------------------------------------------------
# Supabase (2단계에서 실제 값 입력)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키. 절대 NEXT_PUBLIC_ 을 붙이지 말 것 (붙이면 브라우저에 노출된다)
SUPABASE_SERVICE_ROLE_KEY=

# DB 직접 접속 — 마이그레이션 실행(npm run db:migrate)에만 쓴다.
# Supabase 대시보드 > Project Settings > Database > Connection string > Transaction pooler
# 배포(Vercel)에는 넣지 않아도 된다.
SUPABASE_DB_URL=

# 데이터 소스: 비워두면 자동 판단 (Supabase 키가 있으면 supabase, 없으면 seed)
DATA_SOURCE=

# ---------------------------------------------------------------------------
# 네이버 검색 API — 플레이스 자동채움에서 주소·업종·전화를 가져올 때 쓴다
#
#   https://developers.naver.com/apps  에서 애플리케이션 등록
#   → 사용 API 에 "검색" 추가 → Client ID / Secret 발급
#
# 이 키가 없으면 자동채움이 플레이스 페이지에서 읽은 값만 사용한다.
# (동작은 하지만 주소·업종 정확도가 떨어진다)
# ---------------------------------------------------------------------------
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 소셜 간편로그인 (2단계) — 위 검색 API 키와는 별개의 애플리케이션이다
# ---------------------------------------------------------------------------
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
